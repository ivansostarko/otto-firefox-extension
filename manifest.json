{
  "manifest_version": 2,
  "name": "OTTO Encryptor (Firefox)",
  "description": "End-to-end encryption for text and files using the OTTO format (AES-256-GCM + HKDF, streaming).",
  "version": "0.1.0",
  "browser_action": {
    "default_title": "OTTO",
    "default_popup": "popup.html"
  },
  "permissions": [
    "downloads"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "otto@ivansostarko",
      "strict_min_version": "109.0"
    }
  }
}